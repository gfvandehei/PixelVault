# ── PixelVault Configuration ──────────────────────────────────────────────────
# Copy this to .env and fill in your values.

# REQUIRED: Generate a strong random key — never share this.
# Run: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Set to 'true' when behind HTTPS (enables Secure cookies + HSTS)
HTTPS=false

# Where uploaded files are stored (absolute path recommended in production)
UPLOAD_FOLDER=./uploads
DATA_DIRECTORY=./instance

# Max upload size in MB. Bounds a single legacy (small-file) request, and is also
# checked against the declared total size when a chunked upload is initialised —
# chunking would otherwise leave this bounding only one 8 MiB slice.
MAX_UPLOAD_MB=500

# Flask debug mode — NEVER set to 'true' in production
FLASK_DEBUG=false

# Port for Gunicorn / Flask
PORT=5000

# ── Chunked resumable uploads ─────────────────────────────────────────────────
# See docs/upload_operations.md for what actually changes when you tune these.

# Slice size in bytes handed to the client. Must stay well under the body limit of
# any CDN in front of the app — Cloudflare's free plan rejects bodies over 100 MB.
# Larger = fewer round trips but more data re-sent per failed chunk.
UPLOAD_CHUNK_SIZE=8388608

# How long a partial upload stays resumable before the sweep reclaims its row and
# its .part file. Longer = a better resume window, more disk held by abandonments.
UPLOAD_SESSION_TTL_HOURS=24

# Per-user ceilings on uploads in flight. These are the load-bearing defence
# against a client filling the disk: the rate limiter lives in memory per worker
# and resets on deploy, so it does not bound total bytes.
#
# MAX_INFLIGHT_UPLOAD_MB_PER_USER must be at least MAX_UPLOAD_MB, and ideally
# 3x it. Below 1x, no file larger than this can EVER be uploaded: init accepts
# the declared size against MAX_UPLOAD_MB and this quota then refuses the same
# number. Below 3x, only parallel batches are affected — the browser uploads 3
# files at once and reserves each declared size in full. Raising MAX_UPLOAD_MB
# without raising this is the easy mistake; the app logs it at boot.
MAX_CONCURRENT_UPLOADS_PER_USER=10
MAX_INFLIGHT_UPLOAD_MB_PER_USER=2048

# Number of reverse proxies that append to X-Forwarded-For before a request
# reaches the app, consumed by ProxyFix. Cloudflare -> nginx -> app is 2 IF your
# nginx uses `proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for`.
#
# NEVER set this higher than the true hop count. A client's own X-Forwarded-For
# then survives into the region ProxyFix trusts, letting it name any address it
# likes and choose which rate-limit bucket it is charged under. When unsure, set
# it too low: the cost is a shared bucket, not a bypassable one.
TRUSTED_PROXY_COUNT=1
