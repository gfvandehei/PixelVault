# ── PixelVault Configuration ──────────────────────────────────────────────────
# Copy this to .env and fill in your values.

# REQUIRED: Generate a strong random key — never share this.
# Run: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Set to 'true' when behind HTTPS (enables Secure cookies + HSTS)
HTTPS=false

# Where uploaded files are stored (absolute path recommended in production)
UPLOAD_FOLDER=uploads

# Max upload size in MB (per request, not per file)
MAX_UPLOAD_MB=500

# Flask debug mode — NEVER set to 'true' in production
FLASK_DEBUG=false

# Port for Gunicorn / Flask
PORT=5000
