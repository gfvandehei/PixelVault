# ── PixelVault Configuration ──────────────────────────────────────────────────
# Copy this to .env and fill in your values.

# REQUIRED: Generate a strong random key — never share this.
# Run: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Set to 'true' when behind HTTPS (enables Secure cookies + HSTS)
HTTPS=false

# Where uploaded files are stored (absolute path recommended in production)
UPLOAD_FOLDER=./uploads
DATA_DIRECTORY=./instance

# Max upload size in MB. Bounds a single legacy (small-file) request, and is also
# checked against the declared total size when a chunked upload is initialised —
# chunking would otherwise leave this bounding only one 8 MiB slice.
MAX_UPLOAD_MB=500

# Flask debug mode — NEVER set to 'true' in production
FLASK_DEBUG=false

# Port for Gunicorn / Flask
PORT=5000

# ── Chunked resumable uploads ─────────────────────────────────────────────────
# See docs/upload_operations.md for what actually changes when you tune these.

# Slice size in bytes handed to the client. Must stay well under the body limit of
# any CDN in front of the app — Cloudflare's free plan rejects bodies over 100 MB.
# Larger = fewer round trips but more data re-sent per failed chunk.
UPLOAD_CHUNK_SIZE=8388608

# How long a partial upload stays resumable before the sweep reclaims its row and
# its .part file. Longer = a better resume window, more disk held by abandonments.
UPLOAD_SESSION_TTL_HOURS=24

# Per-user ceilings on uploads in flight. These are the load-bearing defence
# against a client filling the disk: the rate limiter lives in memory per worker
# and resets on deploy, so it does not bound total bytes.
#
# MAX_INFLIGHT_UPLOAD_MB_PER_USER must be at least MAX_UPLOAD_MB, and ideally
# 3x it. Below 1x, no file larger than this can EVER be uploaded: init accepts
# the declared size against MAX_UPLOAD_MB and this quota then refuses the same
# number. Below 3x, only parallel batches are affected — the browser uploads 3
# files at once and reserves each declared size in full. Raising MAX_UPLOAD_MB
# without raising this is the easy mistake; the app logs it at boot.
MAX_CONCURRENT_UPLOADS_PER_USER=10
MAX_INFLIGHT_UPLOAD_MB_PER_USER=2048

# Number of reverse proxies that append to X-Forwarded-For before a request
# reaches the app, consumed by ProxyFix. Cloudflare -> nginx -> app is 2 IF your
# nginx uses `proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for`.
#
# NEVER set this higher than the true hop count. A client's own X-Forwarded-For
# then survives into the region ProxyFix trusts, letting it name any address it
# likes and choose which rate-limit bucket it is charged under. When unsure, set
# it too low: the cost is a shared bucket, not a bypassable one.
#
# And the count only means anything if the chain cannot be walked around. A caller
# that reaches the app directly has no proxy in front of it, so its own header is
# the first one and lands in the trusted position whatever this is set to — which
# is why docker/prod.docker-compose.yml publishes the port on 127.0.0.1 only. If
# you change how the app is reached, this is the line that moves with it.
# docs/configuration.md §6 has the topology check and the CF-Connecting-IP
# recommendation.
TRUSTED_PROXY_COUNT=1

# ── Mail & invites ────────────────────────────────────────────────────────────
# See docs/configuration.md for the full reference, including the Gmail profile.

# The canonical external origin invite links are built from. Deliberately NOT
# derived from the request's Host header: behind Cloudflare -> nginx an
# attacker-controlled Host on the add-email request could otherwise steer an
# invite link at a domain they own. No trailing slash. Required once SMTP is set;
# the app refuses to boot without it.
PUBLIC_BASE_URL=https://photos.example.com

# false -> nothing is sent. Invites are still issued, and an admin can still hand
# the link over with the copy-link button; only delivery stops.
MAIL_ENABLED=true

# Leave SMTP_HOST empty to run without a relay: invite emails are then printed to
# the application log, link included, which is what a dev checkout wants.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# starttls (587, upgrade in band) | ssl (465, TLS from the first byte) | none.
# 'none' sends credentials in the clear — only defensible for a relay on localhost.
SMTP_SECURITY=starttls

# Envelope and header sender. With Gmail this MUST be the SMTP_USERNAME account:
# Google rewrites a From address it does not own, so anything else silently
# becomes the account address anyway.
MAIL_FROM=
MAIL_FROM_NAME=PixelVault

# Socket timeout for the whole SMTP conversation. Sends run synchronously inside
# the admin's request and the server has 8 threads total, so an unbounded send
# against a relay that accepts the connection and goes quiet holds an eighth of
# the server until the kernel gives up.
MAIL_TIMEOUT_SECONDS=10

# Address shown to share-link guests who have no account, so they know who to ask
# for an invitation. Defaults to MAIL_FROM.
ADMIN_CONTACT=

# How long an invite link stays usable, from issue or resend. Longer is friendlier
# to someone who checks mail weekly; it is also longer for a link sitting in a
# forwarded email or a compromised mailbox to be usable by someone else.
INVITE_TTL_HOURS=72

# Minimum gap between two sends of the same invite. Not politeness: without it the
# resend button is a mail-bomb aimed at whatever address was typed in, and the
# sending domain's reputation with the relay pays for it.
INVITE_RESEND_COOLDOWN_SECONDS=60
