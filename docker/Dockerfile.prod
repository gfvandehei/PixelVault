FROM python:3.14-slim

# System deps for python-magic and Pillow
RUN apt-get update && apt-get install -y --no-install-recommends \
    libmagic1 \
    libmagic-dev \
    libjpeg-dev \
    libpng-dev \
    libwebp-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ── Dependencies ───────────────────────────────────────────────────────────────
# Installed from uv.lock, not from the floors in pyproject.toml. `pip install .`
# re-resolves on every build, so two builds of the same commit could ship
# different dependency trees — which means the image you tested is not
# necessarily the image you deployed, and a version yanked or a version published
# between the two changes what runs in production with no commit to point at
# (#45). The lock names an exact version and hash for every package installed.
#
# uv is not in python:3.13-slim, so it is installed explicitly and pinned: an
# unpinned installer resolving the pinned dependencies would just move the
# irreproducibility up one level.
RUN pip install --no-cache-dir uv==0.11.32

COPY pyproject.toml uv.lock ./

# --locked, not --frozen. --frozen installs the lock whatever pyproject.toml now
# says; --locked first asserts the two still agree and fails the build if they do
# not. That failure is the point: editing a dependency in pyproject.toml without
# running `uv lock` would otherwise produce an image silently missing the new
# package, which surfaces as an ImportError at boot rather than as a build error
# with an obvious fix.
#
# --no-install-project because the app is not installed as a package — there is no
# [build-system] in pyproject.toml and the source is placed on PYTHONPATH below.
# --no-dev keeps test-only dependencies out of the runtime image.
# UV_PYTHON_DOWNLOADS=never forces the base image's interpreter; without it uv may
# fetch its own Python and build against a different one than the apt libraries
# above were installed for.
ENV UV_PYTHON_DOWNLOADS=never
RUN uv sync --locked --no-dev --no-install-project

# uv syncs into /app/.venv; put it ahead of the system interpreter so `gunicorn`
# below resolves to the locked one.
ENV PATH="/app/.venv/bin:$PATH"

COPY ./src/pixelvault ./src/pixelvault
COPY ./templates ./templates
COPY ./static ./static
COPY ./app.py ./app.py
ENV PYTHONPATH=./src

# Create upload directory
RUN mkdir -p uploads instance && chmod 755 uploads instance

# Non-root user for security
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 5000

# ── Gunicorn ───────────────────────────────────────────────────────────────────
# Worker class: sync workers occupy a worker for the *entire* request, body read
# included, and only heartbeat between requests — so gunicorn's --timeout, which
# is a worker-SILENCE timeout, fires mid-request and SIGKILLs the worker. The
# connection dies with no HTTP status, which is indistinguishable from the
# Cloudflare edge drop that #29 exists to fix. gthread keeps the arbiter's
# heartbeat on a separate thread, so a long request no longer looks like a hung
# worker.
#
# 2 workers x 4 threads = 8 concurrent requests. static/js/uploader.js uses
# CONCURRENCY = 3, so 2 sync workers meant the third upload queued and the rest
# of the site (thumbnails, /api) blocked behind it.
#
# --timeout 900 is still needed *after* chunking: no single 8 MiB chunk comes
# close, but the `complete` step runs validate_file + save_file synchronously in
# one request — HEIC decode, EXIF transpose, and 400x400 thumbnail generation
# (src/pixelvault/utils.py) — and a very large image can exceed 120 s there.
# --graceful-timeout 60 bounds how long a deploy waits for in-flight chunks
# before it stops being a deploy and starts being an outage.
CMD ["gunicorn", "--bind", "0.0.0.0:5000", \
     "--worker-class", "gthread", \
     "--workers", "2", \
     "--threads", "4", \
     "--timeout", "900", \
     "--graceful-timeout", "60", \
     "app:create_app()"]
